{
  "name": "mundo-catrucho",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mundo-catrucho/web --filter @mundo-catrucho/salas dev",
    "build": "pnpm -r build",
    "test": "pnpm build && pnpm -r --workspace-concurrency=1 test",
    "check": "biome check --diagnostic-level=error . && pnpm -r typecheck && tsc --noEmit -p convex && node apps/web/tools/check-motores.mjs && node apps/web/tools/test-memes.mjs --datos && node docs/generador/validar-contenido.mjs",
    "fix": "biome check --write .",
    "avisos": "biome check .",
    "capturas": "pnpm --filter @mundo-catrucho/web build && pnpm --filter @mundo-catrucho/web capturas",
    "web:dev": "pnpm --filter @mundo-catrucho/web dev",
    "salas:dev": "pnpm --filter @mundo-catrucho/salas dev",
    "catalogo:subir": "node scripts/catalogo.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "convex": "^1.17.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@mundo-catrucho/reglas": "workspace:*"
  }
}
