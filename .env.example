# Mundo Catrucho · variables de entorno (MC-65). Guía completa: docs/ENTORNOS.md
#
# Este archivo es solo un mapa: NUNCA pongás valores reales aquí. Cada variable vive en un lugar distinto:
#   [local]   .env.local en la raíz (ignorado por git). `npx convex dev` lo llena solo.
#   [build]   Al compilar el juego (Vite). Se ven en el navegador: nada secreto.
#   [convex]  `npx convex env set NOMBRE valor` (por entorno: dev, preview, prod) o el panel de Convex.
#   [sala]    Cloudflare: `wrangler secret put NOMBRE --env preview|production`; local en workers/salas/.dev.vars.
#   [github]  Settings → Environments → preview / production (secretos y variables del flujo despliegue.yml).
#
# Sin ninguna variable el juego funciona igual: sin red, con LocalNet y el catálogo empaquetado.

# ── Convex ──────────────────────────────────────────────────────────────────────────────────────────────
# [local] Lo escribe `npx convex dev`. Elige el entorno de desarrollo en la nube (dev:<nombre>).
CONVEX_DEPLOYMENT=
# [local] URL del Convex de desarrollo; el panel (apps/panel) la usa si no hay VITE_CONVEX_URL.
CONVEX_URL=
# [github] Llave de despliegue: de producción en el entorno «production», de vista previa en «preview».
#          Se saca en el panel de Convex → Settings → Deploy keys. SECRETO.
# CONVEX_DEPLOY_KEY=

# ── Juego (apps/web) ── [build] ─────────────────────────────────────────────────────────────────────────
# https://<deployment>.convex.cloud. Sin ella no hay servidor (premios locales, catálogo empaquetado).
# En despliegue.yml: la pone `npx convex deploy` si hay CONVEX_DEPLOY_KEY; si no, la variable de GitHub.
VITE_CONVEX_URL=
# https://mundo-catrucho-salas[-preview].<cuenta>.workers.dev (https, no wss: el juego pregunta /libre por HTTP y
# abre el WebSocket cambiando http por ws). Solo se usa junto con VITE_CONVEX_URL.
# En despliegue.yml sale sola de la publicación de la sala si la variable está vacía.
VITE_SALAS_URL=
# Las pone tools/build.mjs; no las toqués: hd | roblox, web | single.
# VITE_VARIANT=
# VITE_BUILD_MODE=

# ── Secretos compartidos ────────────────────────────────────────────────────────────────────────────────
# [convex] y [sala]: el MISMO valor en el Convex y en la sala de cada entorno, distinto entre entornos.
# Mínimo 32 caracteres: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   SECRETO.
SALA_SECRETO=
# [convex] Llave del panel de contenido (MC-33). Leela con `npx convex env get PANEL_LLAVE`. SECRETO.
PANEL_LLAVE=

# ── Sala en vivo (workers/salas) ── [sala] ──────────────────────────────────────────────────────────────
# https://<deployment>.convex.site del mismo entorno: la sala le reporta cuánta gente hay por tramo.
CONVEX_SITE_URL=
# Opcionales, para pruebas: cada cuánto reporta la ocupación (ms) y cuánto dura una partida juntos (s).
# OCUPACION_MS=30000
# PARTIDA_SEGUNDOS=

# ── Cuentas (Clerk, MC-07) ── todavía no se usan ───────────────────────────────────────────────────────
# [build] Llave pública de Clerk (pk_test_… en dev y preview, pk_live_… en producción).
# VITE_CLERK_PUBLISHABLE_KEY=
# [convex] Dominio emisor del JWT de Clerk para convex/auth.config.ts (https://<algo>.clerk.accounts.dev).
# CLERK_JWT_ISSUER_DOMAIN=
# [github] Solo si un flujo administra Clerk. SECRETO.
# CLERK_SECRET_KEY=

# ── Cloudflare (sala y juego) ── [github] ─────────────────────────────────────────────────────────────────
# Token con la plantilla «Edit Cloudflare Workers». Secreto del repo o de cada entorno. SECRETO.
# CLOUDFLARE_API_TOKEN=
# Variable, solo si el token ve más de una cuenta.
# CLOUDFLARE_ACCOUNT_ID=

# ── Pruebas (apps/web/tools) ── solo en tu terminal ────────────────────────────────────────────────────
# MC_GPU=0          sin GPU (GitHub Actions); MC_LENTO=6 multiplica las esperas
# CHROME_BIN=       navegador para el arnés
